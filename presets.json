{
    "topp-workflow": {
        "High Sensitivity": {
            "_description": "Optimized for detecting low-abundance features with higher noise tolerance",
            "FeatureFinderMetabo": {
                "algorithm:common:noise_threshold_int": 500,
                "algorithm:common:chrom_peak_snr": 2,
                "algorithm:mtd:mass_error_ppm": 15
            }
        },
        "High Specificity": {
            "_description": "Strict parameters for high-confidence feature detection",
            "FeatureFinderMetabo": {
                "algorithm:common:noise_threshold_int": 5000,
                "algorithm:common:chrom_peak_snr": 5,
                "algorithm:mtd:mass_error_ppm": 5
            }
        },
        "Fast Analysis": {
            "_description": "Faster processing with relaxed parameters for quick exploration",
            "FeatureFinderMetabo": {
                "algorithm:common:noise_threshold_int": 2000,
                "algorithm:ffm:isotope_filtering_model": "none"
            },
            "FeatureLinkerUnlabeledKD": {
                "algorithm:link:rt_tol": 60,
                "algorithm:link:mz_tol": 15
            }
        },
        "Metabolomics Default": {
            "_description": "Balanced parameters for general metabolomics analysis",
            "FeatureFinderMetabo": {
                "algorithm:common:noise_threshold_int": 1000,
                "algorithm:common:chrom_peak_snr": 3,
                "algorithm:mtd:mass_error_ppm": 10,
                "algorithm:ffm:charge_lower_bound": 1,
                "algorithm:ffm:charge_upper_bound": 3
            },
            "FeatureLinkerUnlabeledKD": {
                "algorithm:link:rt_tol": 30,
                "algorithm:link:mz_tol": 10
            }
        }
    },
    "flashtnt": {
        "Lysate": {
            "_description": "LC-MS/MS of a cell lysate: MS1 surveys, many spectra, one proteoform per spectrum mostly (FLASHTnT default search). Fragments are annotated from the termini only (no internal fragments). Generated decoys match the target database in size.",
            "FLASHTnT": {
                "native": false
            },
            "FLASHAnnotator": {
                "algorithm:internal_ions": "false"
            },
            "_general": {
                "few_proteins": false
            }
        },
        "Native": {
            "_description": "Native or targeted top-down: one or a few spectra, often several proteins per spectrum, no MS1 survey (FLASHTnT -native). Internal fragments are annotated too. Generated decoys are 10 times the target database, for a finer FDR on few proteins.",
            "FLASHTnT": {
                "native": true
            },
            "FLASHAnnotator": {
                "algorithm:internal_ions": "true"
            },
            "_general": {
                "few_proteins": true
            }
        }
    },
    "ms1-inclusion-planning": {
        "E. coli FAIMS MS1": {
            "_description": "FAIMS-stratified E. coli acetate-versus-glucose MS1 comparison. Review condition names against your design, and configure filters before processing.",
            "_general": {
                "faims-mode": "require",
                "rt-filter-enabled": false,
                "rt-alignment": "pose",
                "coverage-mode": "partial",
                "contrast-a": "acetate",
                "contrast-b": "glucose",
                "q-threshold": 0.05,
                "abs-log2fc-threshold": 0.58,
                "min-qscore": 0.8,
                "top-fraction": 0.5,
                "rt-margin-seconds": 30,
                "priority-quality": 2,
                "priority-diff-abundance": 2,
                "priority-conditional": 2
            }
        }
    }
}
